  "orderedEscalationEvaluation": [
    {
      "order": 1,
      "reason": "VALIDATION_FAILURE",
      "condition": "Schema, structured output, citation or factual-consistency validation fails.",
      "action": "Escalate one tier only where the route permits; otherwise stop."
    },
    {
      "order": 2,
      "reason": "LOW_CONFIDENCE",
      "condition": "The result is below an owner-approved benchmarked confidence threshold.",
      "action": "Escalate one tier only where the route permits; missing threshold stops."
    },
    {
      "order": 3,
      "reason": "CONFLICTING_MATERIAL_EVIDENCE",
      "condition": "Admitted material evidence conflicts and cannot be reconciled by the current tier.",
      "action": "Move from Luna to Terra or Terra to Sol; Sol stops for human resolution."
    },
    {
      "order": 4,
      "reason": "HIGH_RISK_SPECIALIST_CONCLUSION",
      "condition": "The task requires a material legal, compliance, risk or ESG specialist conclusion.",
      "action": "Move to the governed stronger tier and retain specialist/human authority."
    },
    {
      "order": 5,
      "reason": "AUTHORISED_HUMAN_REQUEST",
