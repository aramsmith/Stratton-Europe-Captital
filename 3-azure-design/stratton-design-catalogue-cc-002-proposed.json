  "wafAssessment": [
    {
      "pillar": "Reliability",
      "response": "Fixed routes, fail-closed dependency handling, version pinning and evaluation invalidation.",
      "tradeOff": "Analysis pauses instead of using an unvalidated substitute."
    },
    {
      "pillar": "Security",
      "response": "EU Data Zone boundary, private endpoints, managed identities, prompt-injection controls and human authority.",
      "tradeOff": "More identity, policy and assurance evidence is required."
    },
    {
      "pillar": "Cost Optimisation",
      "response": "Smallest sufficient tier and route-level token/cost evidence.",
      "tradeOff": "Three deployments and independent benchmarks add governance cost."
    },
    {
      "pillar": "Operational Excellence",
      "response": "IaC-first, NoAutoUpgrade, versioned route policy, immutable telemetry and runbooks.",
      "tradeOff": "Material configuration changes repeat evaluation and change control."
    },
    {
      "pillar": "Performance Efficiency",
      "response": "Task-tier matching with separate interactive and pack measures.",
