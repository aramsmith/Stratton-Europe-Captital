  "architectureDecisions": [
    {
      "id": "CC002-AD-001",
      "decision": "Use EU Data Zone Standard for all Azure OpenAI inference deployments.",
      "constraints": [
        "Global Standard prohibited",
        "Microsoft selects processing region within the EU Data Zone",
        "no specific processing-region promise",
        "data at rest remains in designated EU geography"
      ],
      "status": "CANDIDATE_REVIEW_PENDING"
    },
    {
      "id": "CC002-AD-002",
      "decision": "Pin gpt-5.6-luna, gpt-5.6-terra and gpt-5.6-sol to version 2026-07-09 with NoAutoUpgrade.",
      "status": "CANDIDATE_REVIEW_PENDING"
    },
    {
      "id": "CC002-AD-003",
      "decision": "Use deterministic workflow routing with eight fixed task classes and five ordered escalation reasons.",
      "status": "CANDIDATE_REVIEW_PENDING"
    },
    {
      "id": "CC002-AD-004",
      "decision": "Use prebuilt-layout, text-embedding-3-large and deterministic or classical anomaly methods as the specialist foundation.",
      "status": "CANDIDATE_REVIEW_PENDING"
    },
    {
      "id": "CC002-AD-005",
      "decision": "Block production promotion until route-specific quality, security, performance, owner and human gates pass.",
      "status": "CANDIDATE_REVIEW_PENDING"
    }
  ],
  "solutionBuildingBlockAmendments": [
