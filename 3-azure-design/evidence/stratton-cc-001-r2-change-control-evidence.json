  "formalFindings": [
    {
      "id": "AFFB-CC001-MAJ-001",
      "severity": "MAJOR",
      "finding": "Dedicated Internal Audit source-repository boundary is undefined and repository acceptance/build/signing/ACR push/deployment/operations authority is concentrated.",
      "remediation": [
        "Dedicated independently administered Internal Audit repository/equivalent source boundary with all platform/policy/retention/authentication values fail closed",
        "Delivery controlled contribution only; no write/merge/admin/release authority",
        "Separate merge, build, signing, ACR publication, DU-16 deployment, production operations and rollback identities with two-person independent approvals, PIM/CA/access review",
        "Immutable accepted-tree-to-deployed-digest/configuration chain, cross-role negatives, constrained break-glass, key custody and prior-approved-release rollback"
      ],
      "status": "RESOLVED_IN_R2_CANDIDATE_PENDING_FORMAL_REVIEW"
    },
    {
      "id": "AFFB-CC001-MAJ-002",
      "severity": "MAJOR",
      "finding": "Receipts omit signedAt and signed records do not immutably bind exact signing-time algorithm policy, trust registry, signer mapping, key-validity and revocation/compromise snapshots.",
      "remediation": [
        "TrustVerificationSnapshot schema includes all required signing-time policy/registry/mapping/identity/key/validity/revocation/disposition/schema/retention fields",
        "Submission, event, receipt and verdict require signedAt plus snapshot/hash in canonical preimage; only signature bytes excluded",
        "Record and snapshot co-retained in WORM for full period with immutable historical rotation/revocation/compromise/registry/rollback/DR semantics",
        "Canonical and negative vectors include missing/mismatch/time/purpose/registry/revocation/unknown compromise/tamper/WORM recovery cases"
      ],
      "status": "RESOLVED_IN_R2_CANDIDATE_PENDING_FORMAL_REVIEW"
    }
  ],
