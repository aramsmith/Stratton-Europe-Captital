{
  "name": "@stratton/demo-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src server --max-warnings 0"
  },
  "dependencies": {
    "@azure/msal-browser": "5.17.3",
    "@fluentui/react-components": "9.72.0",
    "@stratton/contracts": "*",
    "express": "5.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.8.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "jsdom": "26.1.0",
    "supertest": "7.1.4",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
